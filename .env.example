# ===========================================
# Telegram Bot Hosting Platform - Environment Variables
# ===========================================

# ---------------- Required ----------------
# Token of the control-plane Telegram bot created with @BotFather
# احصل على التوكن من @BotFather وأضفه هنا
HOST_BOT_TOKEN=your-control-bot-token

# Telegram user IDs allowed to use /admin (comma-separated)
# أضف معرفك الرقمي من @userinfobot
ADMIN_IDS=your-telegram-user-id

# ---------------- Encryption (Required for Production) ----------------
# Generate a permanent 32-byte base64 key for production:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty only for local development (values will be lost on restart)
ENCRYPTION_KEY=

# ---------------- Paths ----------------
DATABASE_PATH=/app/data/hosting.db
BOTS_DIR=/app/data/uploaded_bots
# Railway injects PORT automatically; 8080 is for local Docker only
PORT=8080

# ---------------- Platform Limits ----------------
DEFAULT_MAX_BOTS=3
MAX_FILE_SIZE_MB=25
MAX_EXTRACTED_SIZE_MB=200
MAX_ZIP_FILE_COUNT=2000
MAX_BOT_MEMORY_MB=1024
MAX_BOT_CPU_SECONDS=3600

# ---------------- Monitoring & Reliability ----------------
WATCHDOG_INTERVAL=20
MAX_AUTO_RESTART_ATTEMPTS=5
CRASH_LOOP_RESET_SECONDS=300
RESTART_BACKOFF_BASE_SECONDS=5
MAX_LOG_SIZE_MB=10
LOG_TAIL_LINES=60
HEALTH_CHECK_TIMEOUT_SECONDS=6
USAGE_HISTORY_INTERVAL_SECONDS=300
USAGE_HISTORY_MAX_POINTS=50

# ---------------- Rate Limiting ----------------
# Max messages per user per minute (0 = disabled)
RATE_LIMIT_MSGS_PER_MINUTE=10

# ---------------- Backup Configuration ----------------
# Interval in seconds between automatic backups (default: 1 hour)
BACKUP_INTERVAL_SECONDS=3600
# Directory to store backup files
BACKUP_DIR=/app/data/backups

# ---------------- AI Analyzer Settings ----------------
# Enable AI-powered bot analysis (default: true)
AI_ANALYZER_ENABLED=true
# Maximum file size for AI analysis (in MB)
AI_ANALYZER_MAX_FILE_SIZE_MB=50

# ---------------- Security ----------------
# Protected environment keys that cannot be overridden by users
PROTECTED_ENV_KEYS=PATH,LD_PRELOAD,LD_LIBRARY_PATH,PYTHONHOME,PYTHONPATH,PYTHONSTARTUP

# ---------------- Optional: Hosted Bot Token Key ----------------
# Environment key name used by getMe health checks
BOT_TOKEN_ENV_KEY=BOT_TOKEN

# ---------------- Docker Isolation Settings ----------------
# Enable Docker container isolation for bots (default: false)
USE_DOCKER=false
# Docker socket path (change if using Docker-in-Docker or remote Docker)
DOCKER_SOCKET=/var/run/docker.sock

# ---------------- Web Dashboard Settings ----------------
# Enable FastAPI web dashboard for admin control (default: true)
DASHBOARD_ENABLED=true
# Dashboard host and port
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ---------------- Database Scaling (Optional) ----------------
# Use PostgreSQL instead of SQLite for production scaling
USE_POSTGRESQL=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bot_hosting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password

# ---------------- Redis Caching (Optional) ----------------
# Use Redis for caching and rate limiting
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------- AI Analysis Settings ----------------
# Enable AI-powered bot analysis (default: true)
AI_ANALYSIS_ENABLED=true
# Maximum file size for AI analysis (in KB)
AI_MAX_FILE_SIZE_KB=512

# ---------------- Advanced Performance Tuning ----------------
# Max concurrent venv/pip setups to prevent server overload
MAX_CONCURRENT_VENV_SETUPS=2
# Interval between usage history snapshots (seconds)
CLEANUP_INTERVAL_SECONDS=300
