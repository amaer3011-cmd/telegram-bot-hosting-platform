# Token of the control-plane Telegram bot created with @BotFather
HOST_BOT_TOKEN=your-control-bot-token

# Telegram user IDs allowed to use /admin
ADMIN_IDS=your-telegram-user-id

# Persistent paths
DATABASE_PATH=/app/data/hosting.db
BOTS_DIR=/app/data/uploaded_bots
# Railway injects PORT automatically; 8080 is for local Docker only.
PORT=8080

# Platform limits
DEFAULT_MAX_BOTS=3
MAX_FILE_SIZE_MB=25
MAX_EXTRACTED_SIZE_MB=200
MAX_ZIP_FILE_COUNT=2000
MAX_BOT_MEMORY_MB=1024
MAX_BOT_CPU_SECONDS=3600

# Monitoring and reliability
WATCHDOG_INTERVAL=20
MAX_AUTO_RESTART_ATTEMPTS=5
CRASH_LOOP_RESET_SECONDS=300
RESTART_BACKOFF_BASE_SECONDS=5
MAX_LOG_SIZE_MB=10
LOG_TAIL_LINES=60
HEALTH_CHECK_TIMEOUT_SECONDS=6
USAGE_HISTORY_INTERVAL_SECONDS=300
USAGE_HISTORY_MAX_POINTS=50

# Rate limiting: max messages per user per minute (0 = disabled)
RATE_LIMIT_MSGS_PER_MINUTE=10

# Encryption: set a permanent 32-byte base64 key for production.
# Generate one via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty only for local development (values are lost on restart).
ENCRYPTION_KEY=

# Optional: hosted bot token environment key used by getMe health checks
BOT_TOKEN_ENV_KEY=BOT_TOKEN
